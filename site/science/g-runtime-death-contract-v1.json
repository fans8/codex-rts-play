  "fragmentTransform": {
    "sourceRect": "fragment tile selected from8 physical chips,4columns2rows",
    "baseCellLogicalPx": 32,
    "pivotNormalized": [
      0.5,
      0.5
    ],
    "logicalCenter": "death-world body snapshot + ballistic delta",
    "allSizesUniform": true,
    "noAnisotropicSquash": true,
    "drawCellSizeLogicalPx": "21 + 12*U(n+70), [21,33)",
    "uniformScaleFrom32pxCell": "drawCellSizeLogicalPx /32",
    "initialRotationRadians": "pi*U(n+100), [0,pi)",
    "angularVelocityRadiansPerSecond": "(1.1 + 3.1*U(n+90)) * (j%2 ? -1 : 1), abs[1.1,4.2)",
    "fragmentIndex": "j=0..variant.fragmentCount-1",
    "n": "j + variantIndex*19",
    "physicalTile": "(j+variantIndex*3)%8",
    "trajectoryAngleRadians": "j*2.399963 + variantIndex*.63 + (U(n+400)-.5)*.48 + (variantIndex==2 ? .45 : 0)",
    "radialDistanceLogicalPx": "(39+35*U(n+40))*variant.radius",
    "radialDistanceOverallRangeLogicalPx": [
      35.88,
      84.36
    ],
    "dragPerSecond": 2.4,
    "tSeconds": "clamp(ageMs,0,1400)/1000",
    "radialProgress": "1-exp(-2.4*t)",
    "deltaXLogicalPx": "cos(angle)*radialDistance*radialProgress",
    "deltaYLogicalPx": "sin(angle)*radialDistance*.58*radialProgress -18*t +34*t*t",
    "gravityLogicalPxPerSec2": 68,
    "initialVerticalVelocityLogicalPxPerSec": -18,
    "radialInitialSpeedLogicalPxPerSec": "2.4*radialDistance; [86.112,202.464)",
    "opacity": "1-smoothstep((ageMs-330)/1070), clamped; zero at1400ms",
    "rotationAroundSamePivot": true,
    "destinationMeaning": "Every density maps to identical logical center/size; scale by1x or2x only at final raster draw.",
    "rotationRadians": "initialRotationRadians+angularVelocityRadiansPerSecond*tSeconds",
    "optionalDrawCommandMapping": {
      "pivot": "sourceRect center in density pixels",
      "rotationRadians": "rotationRadians above",
      "uniformScale": "baseSizeLogicalPx/32; same logical size at1x and2x",
      "destination": "center=deathWorldSnapshot+delta; rotate around this center, never destination top-left or terrain anchor"
    }
  },
